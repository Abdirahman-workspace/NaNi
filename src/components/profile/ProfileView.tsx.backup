    alignItems: "center",
    minWidth: 54,
  },
  statValue: {
    color: Colors.text,
    fontSize: 17,
    fontWeight: FontWeight.bold,
  },
  statLabel: {
    color: "rgba(255,255,255,0.68)",
    fontSize: 10,
    marginTop: 2,
    textTransform: "uppercase",
    letterSpacing: 0.3,
  },

  // Info
  infoSection: {
    paddingHorizontal: 20,
    paddingTop: 4,
  },
  nameRow: {
    flexDirection: "row",
    alignItems: "center",
    justifyContent: "space-between",
  },
