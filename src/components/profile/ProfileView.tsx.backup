    width: 34,
    height: 34,
    borderRadius: 10,
    backgroundColor: Colors.surfaceElevated,
    borderWidth: 1,
    borderColor: Colors.borderSubtle,
    alignItems: "center",
    justifyContent: "center",
  },
  username: {
    color: "rgba(255,255,255,0.62)",
    fontSize: FontSize.sm,
    marginTop: 4,
  },
  bio: {
    color: "rgba(255,255,255,0.65)",
    fontSize: FontSize.base,
    lineHeight: 21,
    marginTop: 12,
  },
  linkRow: {
    flexDirection: "row",
    alignItems: "center",
    gap: 6,
    marginTop: 8,
  },
  link: {
    color: Colors.accent,
    fontSize: FontSize.sm,
  },

  // Action row
  actionRow: {
    flexDirection: "row",
